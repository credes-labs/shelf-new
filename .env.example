# ── Site ──────────────────────────────────────────────────────────────────────
# Public values are safe to expose. The service-role key must stay server-side.
# Canonical origin used for metadata / social images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only values used by /api/waitlist. Supabase's "publishable key" is
# the anon-key equivalent, so either variable name works.
# The waitlist_join RPC is SECURITY DEFINER and is the only thing the key needs.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# New Supabase projects may label the same value "publishable key":
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Optional fallback if you prefer a service-role connection. Keep it server-only.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Public copies are only needed if a browser-side Supabase client is added later.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# ── Payload CMS ───────────────────────────────────────────────────────────────
# Leave PAYLOAD_URL empty to render the bundled fallback articles.
PAYLOAD_URL=http://localhost:3001
PAYLOAD_REVALIDATE_SECONDS=60

# Must match REVALIDATE_SECRET in cms/.env. The CMS calls this site after edits.
REVALIDATE_SECRET=<same-secret-as-cms>
