# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules/
/.pnp/
.pnp.*

# Next.js and generated build output
/.next/
/.next*/
/out/
/build/
/dist/
/coverage/
/.turbo/
/.cache/
/playwright-report/
/test-results/

# Local deployments
/.vercel/

# Agent / tooling workspaces (local-only, never commit)
/.claude/
/.next-codex-verify-*/

# Environment and secrets (keep example templates)
.env*
!.env.example
!.env.*.example

# Logs and diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.eslintcache

# TypeScript and generated framework files
*.tsbuildinfo
next-env.d.ts

# Operating system and editor artifacts
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
