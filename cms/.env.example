DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PAYLOAD_SECRET=replace-with-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=replace-with-the-same-secret-you-put-on-the-site

# Optional: create the first admin user during `npm run seed`
PAYLOAD_SEED_EMAIL=
PAYLOAD_SEED_PASSWORD=

# Optional: upload media to Supabase Storage instead of cms/media.
# Supabase dashboard -> Storage -> create a public bucket, then create S3 access keys.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL for the bucket, e.g. https://<ref>.supabase.co/storage/v1/object/public/shelf-media
SUPABASE_PUBLIC_MEDIA_URL=
